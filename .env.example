# Copie para .env e preencha (use o mesmo usuário de API dos seus outros projetos)
SIENGE_SUBDOMINIO=suaempresa
SIENGE_USUARIO=suaempresa-api
SIENGE_SENHA=
# true = dados de demonstração, sem chamar o Sienge
USE_MOCK=true
PORT=3000
CACHE_MINUTOS=15
# Endpoint das saídas de estoque / consumo por obra (confirme no seu Sienge)
SIENGE_ENDPOINT_CONSUMO=/stock-movements
# Login do painel (criado no primeiro start; se omitir a senha, uma aleatória é exibida no console)
PAINEL_USUARIO=admin
PAINEL_SENHA=
