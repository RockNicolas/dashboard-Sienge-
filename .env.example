# Copie para .env e preencha.
# A conexão com o Sienge (subdomínio, usuário e senha da API, endpoint de consumo, limite diário e modo demonstração)
# é configurada no próprio painel, na tela Configurações — não vai aqui.
PORT=3000
CACHE_MINUTOS=15
# Login do painel (criado no primeiro start; se omitir a senha, uma aleatória é exibida no console)
PAINEL_USUARIO=admin
PAINEL_SENHA=
# Por padrão o painel só abre na própria máquina (127.0.0.1). Para abrir na rede use HOST=0.0.0.0 (de preferência atrás de HTTPS)
HOST=127.0.0.1
# true quando houver proxy reverso (nginx/Caddy) na frente: cookie Secure em HTTPS e IP real no bloqueio de login
TRUST_PROXY=false
